# AI YouTube Shorts Bot - Environment Configuration
# Copy this file to .env and fill in your API keys.

# --- OpenAI API Key (required for script generation) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# --- Video Generation Provider ---
# Options: "runway", "pika", "stable_video_diffusion"
VIDEO_PROVIDER=stable_video_diffusion

# --- Runway API Key (if using Runway) ---
RUNWAY_API_KEY=your_runway_api_key_here

# --- Pika API Key (if using Pika) ---
PIKA_API_KEY=your_pika_api_key_here

# --- Stable Video Diffusion API URL (if using local SVD) ---
SVD_API_URL=http://localhost:7860/api/generate-video

# --- YouTube OAuth ---
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# --- Voice Settings ---
VOICE_NAME=en-US-GuyNeural
VOICE_RATE=+0%

# --- Output ---
OUTPUT_DIR=output

# --- Scheduling ---
# Delay between video productions in seconds (default: 1 hour)
PRODUCTION_DELAY_SECONDS=3600
# Maximum videos per day (target: 10-20)
MAX_VIDEOS_PER_DAY=20
