# ─────────────────────────────────────────────────────────────────────────────
# YoutubeAI – Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (required) ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Model used for script generation (default: gpt-4o)
OPENAI_MODEL=gpt-4o
# TTS model: tts-1 (fast) or tts-1-hd (high quality)
OPENAI_TTS_MODEL=tts-1
# Voice for OpenAI TTS: alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=onyx

# ── Video generation backend ─────────────────────────────────────────────────
# Choose one: runway | pika | stable_video
VIDEO_BACKEND=runway

# Runway ML (required when VIDEO_BACKEND=runway)
RUNWAY_API_KEY=

# Pika (required when VIDEO_BACKEND=pika)
PIKA_API_KEY=

# Stable Video Diffusion (required when VIDEO_BACKEND=stable_video)
# HuggingFace model ID or local path
SVD_MODEL_PATH=stabilityai/stable-video-diffusion-img2vid-xt

# ── TTS backend ──────────────────────────────────────────────────────────────
# Choose one: openai | elevenlabs
TTS_BACKEND=openai

# ElevenLabs (required when TTS_BACKEND=elevenlabs)
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs account (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
# Path to the OAuth 2.0 client secrets JSON file downloaded from
# https://console.cloud.google.com/ → APIs & Services → Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
# Where to cache the OAuth token after first authorisation
YOUTUBE_TOKEN_FILE=youtube_token.json
# YouTube category ID (22=People & Blogs, 24=Entertainment, 28=Science & Tech)
YOUTUBE_CATEGORY_ID=22

# ── Scheduling ───────────────────────────────────────────────────────────────
# Number of Shorts to upload per day (10–20 recommended)
UPLOADS_PER_DAY=12

# ── Content ──────────────────────────────────────────────────────────────────
# Default content type: curiosity | suspense | random
CONTENT_TYPE=random

# ── Output ───────────────────────────────────────────────────────────────────
# Directory for generated audio/video files (created automatically)
OUTPUT_DIR=output
